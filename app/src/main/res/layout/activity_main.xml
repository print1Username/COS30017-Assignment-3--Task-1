<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/page_background"
	android:orientation="vertical">

	<androidx.fragment.app.FragmentContainerView
		android:id="@+id/fragmentContainer"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1" />

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:gravity="center"
		android:orientation="horizontal">

		<TextView
			android:id="@+id/pageOneDot"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:contentDescription="@string/page_one"
			android:gravity="center"
			android:text="@string/page_indicator_dot"
			android:textColor="@color/total_text"
			android:textSize="22sp" />

		<TextView
			android:id="@+id/pageTwoDot"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:contentDescription="@string/page_two"
			android:gravity="center"
			android:text="@string/page_indicator_dot"
			android:textColor="@android:color/darker_gray"
			android:textSize="22sp" />

	</LinearLayout>

</LinearLayout>
