<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/page_background"
	android:fillViewport="true">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical">

		<!-- App header -->
		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:background="@color/header_background"
			android:gravity="start|center_vertical"
			android:paddingStart="16dp"
			android:paddingTop="10dp"
			android:paddingBottom="10dp"
			android:text="@string/app_title"
			android:textColor="@color/header_text"
			android:textSize="20sp"
			android:textStyle="normal" />

		<!-- Sandwich banner -->
		<ImageView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:adjustViewBounds="true"
			android:contentDescription="@null"
			android:scaleType="fitCenter"
			android:src="@drawable/sandwiches" />

		<!-- ==================== FILLING ==================== -->

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical">

			<!-- Filling title -->
			<TextView
				android:id="@+id/fillingSelection"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:background="@color/section_background"
				android:gravity="center"
				android:padding="8dp"
				android:text="@string/filling_selection"
				android:textColor="@color/section_text"
				android:textSize="16sp"
				android:textStyle="bold" />

			<!-- Filling options -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:background="@color/page_background"
				android:orientation="vertical"
				android:paddingTop="8dp"
				android:paddingBottom="8dp">

				<!-- First row: Ham, Roasted Chicken, Beef Steak -->
				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center"
					android:orientation="horizontal">

					<!-- Ham -->
					<LinearLayout
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:gravity="center"
						android:orientation="horizontal">

						<CheckBox
							android:id="@+id/checkHam"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:buttonTint="@color/option_color" />

						<ImageView
							android:layout_width="wrap_content"
							android:layout_height="37dp"
							android:adjustViewBounds="true"
							android:contentDescription="@string/content_ham"
							android:scaleType="fitCenter"
							android:src="@drawable/cut_ham_icon" />

					</LinearLayout>

					<!-- Roasted Chicken -->
					<LinearLayout
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:gravity="center"
						android:orientation="horizontal">

						<CheckBox
							android:id="@+id/checkChicken"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:buttonTint="@color/option_color" />

						<ImageView
							android:layout_width="wrap_content"
							android:layout_height="37dp"
							android:adjustViewBounds="true"
							android:contentDescription="@string/content_chicken"
							android:scaleType="fitCenter"
							android:src="@drawable/chicken_icon" />

					</LinearLayout>

					<!-- Beef Steak -->
					<LinearLayout
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:gravity="center"
						android:orientation="horizontal">

						<CheckBox
							android:id="@+id/checkBeef"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:buttonTint="@color/option_color" />

						<ImageView
							android:layout_width="wrap_content"
							android:layout_height="37dp"
							android:adjustViewBounds="true"
							android:contentDescription="@string/content_beef"
							android:scaleType="fitCenter"
							android:src="@drawable/beef_icon" />

					</LinearLayout>

				</LinearLayout>

				<!-- Second row: Grilled Salmon, Kebab -->
				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center"
					android:orientation="horizontal">

					<!-- Grilled Salmon -->
					<LinearLayout
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:gravity="center"
						android:orientation="horizontal">

						<CheckBox
							android:id="@+id/checkSalmon"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:buttonTint="@color/option_color" />

						<ImageView
							android:layout_width="wrap_content"
							android:layout_height="37dp"
							android:adjustViewBounds="true"
							android:contentDescription="@string/content_salmon"
							android:scaleType="fitCenter"
							android:src="@drawable/salmon_icon" />

					</LinearLayout>

					<!-- Kebab -->
					<LinearLayout
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:gravity="center"
						android:orientation="horizontal">

						<CheckBox
							android:id="@+id/checkKebab"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:buttonTint="@color/option_color" />

						<ImageView
							android:layout_width="wrap_content"
							android:layout_height="37dp"
							android:adjustViewBounds="true"
							android:contentDescription="@string/content_kebab"
							android:scaleType="fitCenter"
							android:src="@drawable/kebab_icon2" />

					</LinearLayout>

					<!-- Empty space to keep the second row balanced -->
					<Space
						android:layout_width="0dp"
						android:layout_height="1dp"
						android:layout_weight="1" />

				</LinearLayout>

			</LinearLayout>

		</LinearLayout>

		<!-- ==================== SIDE ==================== -->

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical">

			<!-- Side title -->
			<TextView
				android:id="@+id/sideSelection"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:background="@color/section_background"
				android:gravity="center"
				android:padding="8dp"
				android:text="@string/side_selection"
				android:textColor="@color/section_text"
				android:textSize="16sp"
				android:textStyle="bold" />

			<!-- Side options -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:background="@color/page_background"
				android:gravity="center"
				android:orientation="horizontal"
				android:paddingTop="8dp"
				android:paddingBottom="8dp">

				<!-- Tomato -->
				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:gravity="center"
					android:orientation="horizontal">

					<CheckBox
						android:id="@+id/checkTomato"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:buttonTint="@color/option_color" />

					<ImageView
						android:layout_width="wrap_content"
						android:layout_height="37dp"
						android:adjustViewBounds="true"
						android:contentDescription="@string/content_tomato"
						android:scaleType="fitCenter"
						android:src="@drawable/tomato_icon" />

				</LinearLayout>

				<!-- Lettuce -->
				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:gravity="center"
					android:orientation="horizontal">

					<CheckBox
						android:id="@+id/checkLettuce"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:buttonTint="@color/option_color" />

					<ImageView
						android:layout_width="wrap_content"
						android:layout_height="37dp"
						android:adjustViewBounds="true"
						android:contentDescription="@string/content_lettuce"
						android:scaleType="fitCenter"
						android:src="@drawable/lettuce_icon" />

				</LinearLayout>

				<!-- Onion -->
				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:gravity="center"
					android:orientation="horizontal">

					<CheckBox
						android:id="@+id/checkOnion"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:buttonTint="@color/option_color" />

					<ImageView
						android:layout_width="wrap_content"
						android:layout_height="37dp"
						android:adjustViewBounds="true"
						android:contentDescription="@string/content_onion"
						android:scaleType="fitCenter"
						android:src="@drawable/onion_icon" />

				</LinearLayout>

				<!-- Cheese -->
				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:gravity="center"
					android:orientation="horizontal">

					<CheckBox
						android:id="@+id/checkCheese"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:buttonTint="@color/option_color" />

					<ImageView
						android:layout_width="wrap_content"
						android:layout_height="37dp"
						android:adjustViewBounds="true"
						android:contentDescription="@string/content_cheese"
						android:scaleType="fitCenter"
						android:src="@drawable/cheese_icon" />

				</LinearLayout>

			</LinearLayout>

		</LinearLayout>

		<!-- ==================== SIZE ==================== -->

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical">

			<!-- Size title -->
			<TextView
				android:id="@+id/sizeSelection"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:background="@color/section_background"
				android:gravity="center"
				android:padding="8dp"
				android:text="@string/size_selection"
				android:textColor="@color/section_text"
				android:textSize="16sp"
				android:textStyle="bold" />

			<!-- Size options -->
			<RadioGroup
				android:id="@+id/radioSize"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:background="@color/page_background"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<!-- 6 inch - left -->
				<RadioButton
					android:id="@+id/radio6Inch"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:buttonTint="@color/option_color"
					android:gravity="start|center_vertical"
					android:paddingStart="8dp"
					android:text="@string/size_6_inch"
					android:textSize="16sp" />

				<!-- 9 inch - center -->
				<RadioButton
					android:id="@+id/radio9Inch"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:buttonTint="@color/option_color"
					android:gravity="center"
					android:text="@string/size_9_inch"
					android:textSize="16sp" />

				<!-- 12 inch - right -->
				<RadioButton
					android:id="@+id/radio12Inch"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:buttonTint="@color/option_color"
					android:gravity="end|center_vertical"
					android:paddingEnd="8dp"
					android:text="@string/size_12_inch"
					android:textSize="16sp" />

			</RadioGroup>

		</LinearLayout>

		<!-- ==================== TOTAL ==================== -->

		<!-- Divider above total -->
		<View
			android:layout_width="match_parent"
			android:layout_height="1dp"
			android:background="@color/total_divider" />

		<!-- Total row -->
		<FrameLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingTop="6dp"
			android:paddingBottom="6dp">

			<!-- Sandwich icon stays on the left -->
			<ImageView
				android:layout_width="wrap_content"
				android:layout_height="54dp"
				android:layout_gravity="start|center_vertical"
				android:adjustViewBounds="true"
				android:contentDescription="@null"
				android:scaleType="fitCenter"
				android:src="@drawable/sandwich_icon" />

			<!-- Total stays centered on the screen -->
			<LinearLayout
				android:layout_width="wrap_content"
				android:layout_height="match_parent"
				android:layout_gravity="center"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<!-- Total label -->
				<TextView
					android:id="@+id/totalLabel"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="@string/total"
					android:textColor="@color/total_text"
					android:textSize="20sp"
					android:textStyle="bold" />

				<!-- Colon -->
				<TextView
					android:id="@+id/totalColon"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text=":"
					android:textColor="@color/total_text"
					android:textSize="20sp"
					android:textStyle="bold" />

				<!-- Total price -->
				<TextView
					android:id="@+id/totalPrice"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginStart="4dp"
					android:text="@string/default_total"
					android:textColor="@color/total_price"
					android:textSize="20sp"
					android:textStyle="bold" />

			</LinearLayout>

		</FrameLayout>

		<!-- Divider below total -->
		<View
			android:layout_width="match_parent"
			android:layout_height="1dp"
			android:background="@color/total_divider" />

		<!-- ==================== BUTTONS ==================== -->

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center"
			android:orientation="horizontal"
			android:paddingTop="10dp"
			android:paddingBottom="10dp">

			<!-- Place Order -->
			<ImageButton
				android:id="@+id/buttonPlaceOrder"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:background="@android:color/transparent"
				android:contentDescription="@string/content_place_order"
				android:src="@drawable/button_order" />

			<!-- Space between buttons -->
			<Space
				android:layout_width="16dp"
				android:layout_height="1dp" />

			<!-- Reset -->
			<ImageButton
				android:id="@+id/buttonReset"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:background="@android:color/transparent"
				android:contentDescription="@string/content_reset"
				android:src="@drawable/button_reset" />

		</LinearLayout>

	</LinearLayout>

</ScrollView>